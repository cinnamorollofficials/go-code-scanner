{
  "name": "go-code-scanner-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "predocs:build": "npm run docs:check-source-generated && npm run docs:generate-rules && npm run docs:check-generated && npm run docs:check-content && npm run docs:check-editorial && npm run docs:check-cli && npm run docs:check-presets && npm run docs:check-configs && npm run docs:check-deployment",
    "docs:build": "vitepress build docs",
    "docs:build-site": "npm run docs:generate-rules && vitepress build docs",
    "postdocs:build": "npm run docs:check-links && npm run docs:test-browser",
    "docs:preview": "vitepress preview docs",
    "docs:check-presets": "node scripts/validate-config-presets.mjs",
    "docs:generate-rules": "node scripts/generate-rule-catalog.mjs",
    "docs:check-source-generated": "node scripts/check-source-generated.mjs",
    "docs:check-generated": "node scripts/check-generated.mjs",
    "docs:check-content": "node scripts/check-content.mjs",
    "docs:check-editorial": "node scripts/check-editorial.mjs",
    "docs:check-cli": "node scripts/check-cli-examples.mjs",
    "docs:check-configs": "node scripts/validate-config-examples.mjs",
    "docs:check-deployment": "node scripts/check-deployment.mjs",
    "docs:check-links": "node scripts/check-links.mjs",
    "docs:test-browser": "playwright test",
    "docs:verify": "npm run docs:build"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "axe-core": "^4.13.0",
    "typescript": "^5.8.2",
    "vitepress": "^1.6.3",
    "vue": "^3.5.13"
  }
}
