{
  "version": 1,
  "project": "custom-scanners-service",
  "root": ".",
  "mode": "full",
  "output": "security_findings.json",
  "fail_on": "HIGH",
  "include_extensions": [".go"],
  "exclude_directories": [".git", "vendor"],
  "exclude_files": ["security_findings.json"],
  "workers": 4,
  "pattern_max_file_bytes": 1048576,
  "pattern_max_line_bytes": 4096,
  "scanners": {
    "custom-analyzer": {
      "enabled": true,
      "required": false,
      "type": "command",
      "command": ["custom-analyzer", "--format=json"],
      "domain": "security",
      "timeout": "45s"
    }
  }
}
