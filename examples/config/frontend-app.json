{
  "version": 1,
  "project": "frontend-app",
  "root": ".",
  "mode": "full",
  "output": "security_findings.json",
  "fail_on": "HIGH",
  "include_extensions": [".ts", ".tsx", ".js", ".jsx", ".json", ".vue", ".svelte"],
  "exclude_directories": [".git", "node_modules", "dist", ".next", ".nuxt"],
  "exclude_files": ["package-lock.json"],
  "workers": 4,
  "pattern_max_file_bytes": 1048576,
  "pattern_max_line_bytes": 4096,
  "scanners": {},
  "frontend": {
    "enabled": true,
    "frameworks": ["react", "vue", "nextjs"],
    "client_roots": ["src/client", "app"],
    "server_roots": ["src/server", "api"],
    "recognize_sanitizers": ["DOMPurify.sanitize"],
    "detect_import_cycles": true,
    "detect_client_server_boundaries": true
  }
}
